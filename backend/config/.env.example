PORT=8000
NODE_ENV=development
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_MS=2592000000
REFRESH_COOKIE_NAME=goodsly_refresh
COOKIE_SAME_SITE=lax
ALLOW_ADMIN_REGISTRATION=false
ALLOW_DEV_RESET_TOKEN=false
ALLOW_DEV_VERIFICATION_TOKEN=false
DB_URL=mongodb://127.0.0.1:27017/goodsly
# For MongoDB Atlas, use:
# DB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Optional integrations. Leave blank to use the explicit local fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_SUBJECT=mailto:ops@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
API_RATE_LIMIT=300
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=800
# Optional per-IP limit for the public support endpoint (requests per 15 minutes).
AI_SUPPORT_RATE_LIMIT=30
LOG_LEVEL=info
# Optional Redis adapter for multi-instance Socket.IO deployments.
REDIS_URL=
REDIS_REQUIRED=false
# Optional SMTP integration: password/reset delivery is otherwise explicit but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
